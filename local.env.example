# Copy to local.env (not committed) and fill in. Read by scripts/release.sh,
# which also copies it to the Mac.

# The Mac that builds and signs the bridge, reached with your normal SSH key.
OMABUBBLE_MAC=you@your-mac
OMABUBBLE_MAC_PORT=22
# Where on the Mac release.sh keeps its build copy, relative to the home folder.
# OMABUBBLE_MAC_DIR=Library/Caches/omabubble/release

# release.sh also runs ./local-release.sh <tag> <dist dir> after publishing, if
# it exists (not committed either), for anything specific to your setup.
